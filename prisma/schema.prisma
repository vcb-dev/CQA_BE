// Prisma schema tổng — Warehouse + CQA CRM (shared database)
// Chi tiết kho: specs/006-quan-ly-kho/data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ---

enum UserRole {
  warehouse_staff
  purchasing
  store_manager
  sales
  admin
}

enum PermissionScope {
  system
  warehouse
}

enum AccountStatus {
  invited
  active
  inactive
}

enum InventoryBucket {
  on_hand
  committed
  packing
  unavailable
  incoming
}

enum MovementType {
  receipt
  transfer_out
  transfer_in
  return_out
  return_in
  adjust
  order_reserve
  order_release
  order_ship
  packing_start
  packing_cancel
  incoming_po
  incoming_receipt
  incoming_cancel
  incoming_transfer
  transfer_reserve
  transfer_release
}

enum PoStatus {
  don_nhap
  cho_nhap
  da_nhap
  huy
}

enum GoodsReceiptStatus {
  chua_nhap
  da_nhap
  huy
}

enum PaymentStatus {
  chua_thanh_toan
  mot_phan
  da_thanh_toan
}

enum StockTransferStatus {
  nhap
  cho_chuyen
  dang_chuyen
  da_nhan
  huy
}

enum RefundStatus {
  chua_hoan_tien
  da_hoan_tien
}

enum CategoryConditionType {
  manual
  auto
}

enum OrderStatus {
  ordered
  processing
  completed
  cancelled
  returned
}

enum DraftOrderStatus {
  draft
  confirmed
}

enum OrderSource {
  facebook
  tiktok
  shopee
  pos
  web
  zalo
  live_fb
  warranty
  sapo
  other
}

enum VoucherType {
  receipt
  payment
}

// --- Auth & config ---

// --- CQA multi-tenant ---

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  domain       String?  @db.VarChar
  logoUrl      String?  @map("logo_url") @db.VarChar
  primaryColor String?  @map("primary_color") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users        User[]
  chatAudits   ChatAudit[]
  configs      FacebookCskhConfig[]
  sessions     FacebookOAuthSession[]
  jobs         CskhJobRun[]
  monitors     CskhMonitorItem[]
  convs        CskhInboxConversation[]
  messages     CskhInboxMessage[]
  inboxLabels  CskhInboxLabel[]

  @@map("tenants")
}

model User {
  id           BigInt        @id @default(autoincrement())
  email        String        @unique
  passwordHash String?       @map("password_hash")
  name         String?
  phone        String?
  avatarUrl    String?       @map("avatar_url")
  tenantId     String?       @map("tenant_id") @db.Uuid
  roles        UserRole[]    @default([])
  status       AccountStatus @default(active)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  warehouses             UserWarehouse[]
  warehouseRoles         UserWarehouseRole[]
  permissionOverrides    UserPermissionOverride[]
  invitations            UserInvitation[]
  inventoryMoves         InventoryMovement[]      @relation("MovementCreatedBy")
  activityLogs           ActivityLog[]
  assignedSuppliers      Supplier[]               @relation("SupplierAssignedTo")
  purchaseOrders         PurchaseOrder[]          @relation("PoCreatedBy")
  goodsReceipts          GoodsReceipt[]           @relation("ReiCreatedBy")
  goodsReceiptsAssigned  GoodsReceipt[]           @relation("ReiAssignedTo")
  stockTransfersCreated  StockTransfer[]          @relation("StnCreatedBy")
  stockTransfersReceived StockTransfer[]          @relation("StnReceivedBy")
  purchaseReturns        PurchaseReturn[]         @relation("PvnCreatedBy")
  ordersCreated          Order[]                  @relation("OrderCreatedBy")
  ordersAssigned         Order[]                  @relation("OrderAssignedTo")
  orderReturns           OrderReturn[]            @relation("OrderReturnCreatedBy")
  draftOrders            DraftOrder[]             @relation("DraftOrderCreatedBy")
  vouchersCreated        Voucher[]                @relation("VoucherCreatedBy")
  supplierLedgerEntries  SupplierLedgerEntry[]    @relation("SupplierLedgerCreatedBy")
  customerLedgerEntries  CustomerLedgerEntry[]    @relation("CustomerLedgerCreatedBy")
  conversationsAssigned  Conversation[]           @relation("ConversationAssignedTo")
  conversationMessages   ConversationMessage[]    @relation("ConversationMessageAuthor")
  chatAudits             ChatAudit[]
  inboxLabels            CskhInboxLabel[]
  inboxConvViews         CskhInboxConversationView[]

  @@map("users")
}

model UserWarehouse {
  userId      BigInt @map("user_id")
  warehouseId BigInt @map("warehouse_id")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

// --- RBAC động (009) ---

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions    RolePermission[]
  warehouseRoles UserWarehouseRole[]

  @@map("roles")
}

model Permission {
  id    BigInt          @id @default(autoincrement())
  key   String          @unique
  group String
  label String
  scope PermissionScope

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserWarehouseRole {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  warehouseId BigInt   @map("warehouse_id")
  roleId      BigInt   @map("role_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, warehouseId])
  @@map("user_warehouse_roles")
}

// Lệch quyền riêng cho một user tại một kho, chồng lên quyền mặc định của
// role gán tại (user, kho) — không đổi role hay ảnh hưởng user khác.
// granted=true: thêm quyền role không có. granted=false: bỏ quyền role có sẵn.
model UserPermissionOverride {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  warehouseId  BigInt   @map("warehouse_id")
  permissionId BigInt   @map("permission_id")
  granted      Boolean
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId, permissionId])
  @@map("user_permission_overrides")
}

model UserInvitation {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_invitations")
}

model Branch {
  id       BigInt  @id @default(autoincrement())
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  warehouses Warehouse[]

  purchaseOrders PurchaseOrder[]
  priceLists     PriceList[]
  orders         Order[]
  draftOrders    DraftOrder[]
  vouchers       Voucher[]

  @@map("branches")
}

model Warehouse {
  id       BigInt  @id @default(autoincrement())
  code     String  @unique
  name     String
  branchId BigInt  @map("branch_id")
  isActive Boolean @default(true) @map("is_active")

  branch              Branch                   @relation(fields: [branchId], references: [id])
  users               UserWarehouse[]
  userRoles           UserWarehouseRole[]
  permissionOverrides UserPermissionOverride[]
  inventoryLevels     InventoryLevel[]
  movements           InventoryMovement[]
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  transfersFrom       StockTransfer[]          @relation("TransferFrom")
  transfersTo         StockTransfer[]          @relation("TransferTo")
  purchaseReturns     PurchaseReturn[]
  orderItems          OrderItem[]
  draftOrderItems     DraftOrderItem[]
  orderReturnItems    OrderReturnItem[]

  @@map("warehouses")
}

// --- Module Sản phẩm (005) ---

model CustomerGroup {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  priceLists PriceList[]

  @@map("customer_groups")
}

model Product {
  id               BigInt    @id @default(autoincrement())
  sapoId           BigInt?   @unique @map("sapo_id")
  slug             String    @unique
  name             String
  brand            String?
  category         String?
  material         String?
  craftType        String?   @map("craft_type")
  isDiscontinued   Boolean   @default(false) @map("is_discontinued")
  productType      String?   @map("product_type")
  unit             String?
  tags             String[]  @default([])
  requiresShipping Boolean   @default(true) @map("requires_shipping")
  isPublished      Boolean   @default(false) @map("is_published")
  taxable          Boolean   @default(true)
  imageUrl         String?   @map("image_url")
  seoTitle         String?   @map("seo_title")
  seoDescription   String?   @map("seo_description")
  description      String?   @db.Text
  shortDescription String?   @map("short_description") @db.Text
  trackInventory   Boolean   @default(true) @map("track_inventory")
  allowBackorder   Boolean   @default(false) @map("allow_backorder")
  taxIndustryGroup String?   @map("tax_industry_group")
  publishedAt      DateTime? @map("published_at")
  sapoCreatedAt    DateTime? @map("sapo_created_at")
  sapoUpdatedAt    DateTime? @map("sapo_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  variants      ProductVariant[]
  images        ProductImage[]
  options       ProductOption[]
  salesChannels ProductSalesChannel[]
  categories    ProductCategory[]

  @@index([brand, productType])
  @@index([category, material])
  @@map("products")
}

model ProductImage {
  id        BigInt  @id @default(autoincrement())
  productId BigInt  @map("product_id")
  url       String
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model ProductOption {
  id        BigInt @id @default(autoincrement())
  productId BigInt @map("product_id")
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  VariantOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductVariant {
  id             BigInt   @id @default(autoincrement())
  productId      BigInt   @map("product_id")
  sapoId         BigInt?  @unique @map("sapo_id")
  sku            String   @unique
  title          String?
  barcode        String?
  price          Decimal  @default(0) @db.Decimal(18, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(18, 2)
  cost           Decimal  @default(0) @db.Decimal(18, 2)
  weight         Decimal? @db.Decimal(18, 4)
  weightUnit     String?  @map("weight_unit")
  unit           String?
  imageUrl       String?  @map("image_url")
  enabled        Boolean  @default(true)

  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues     VariantOptionValue[]
  inventoryLevels  InventoryLevel[]
  movements        InventoryMovement[]
  lots             Lot[]
  poItems          PurchaseOrderItem[]
  reiItems         GoodsReceiptItem[]
  stnItems         StockTransferItem[]
  pvnItems         PurchaseReturnItem[]
  priceListItems   PriceListItem[]
  orderItems       OrderItem[]
  draftOrderItems  DraftOrderItem[]
  orderReturnItems OrderReturnItem[]
  sapoInboxItems   SapoInboxOrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId BigInt @map("variant_id")
  optionId  BigInt @map("option_id")
  value     String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option  ProductOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([optionId])
  @@map("variant_option_values")
}

model Category {
  id             BigInt                @id @default(autoincrement())
  sapoId         BigInt?               @unique @map("sapo_id")
  name           String
  description    String?               @db.Text
  parentId       BigInt?               @map("parent_id")
  slug           String                @unique
  imageUrl       String?               @map("image_url")
  conditionType  CategoryConditionType @default(manual) @map("condition_type")
  autoConditions Json?                 @map("auto_conditions")
  salesChannels  String[]              @default([]) @map("sales_channels")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@map("categories")
}

model ProductCategory {
  productId  BigInt @map("product_id")
  categoryId BigInt @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductSalesChannel {
  productId BigInt @map("product_id")
  channel   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, channel])
  @@map("product_sales_channels")
}

model PriceList {
  id              BigInt   @id @default(autoincrement())
  code            String   @unique
  name            String
  branchId        BigInt?  @map("branch_id")
  customerGroupId BigInt?  @map("customer_group_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  branch        Branch?         @relation(fields: [branchId], references: [id])
  customerGroup CustomerGroup?  @relation(fields: [customerGroupId], references: [id])
  items         PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id             BigInt   @id @default(autoincrement())
  priceListId    BigInt   @map("price_list_id")
  variantId      BigInt   @map("variant_id")
  fixedPrice     Decimal  @map("fixed_price") @db.Decimal(18, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(18, 2)
  enabled        Boolean  @default(true)

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([priceListId, variantId])
  @@index([variantId])
  @@map("price_list_items")
}

// --- Inventory core ---

model InventoryLevel {
  variantId   BigInt   @map("variant_id")
  warehouseId BigInt   @map("warehouse_id")
  onHand      Int      @default(0) @map("on_hand")
  committed   Int      @default(0)
  packing     Int      @default(0)
  unavailable Int      @default(0)
  incoming    Int      @default(0)
  available   Int      @default(0)
  price       Decimal  @default(0) @db.Decimal(18, 2)
  cost        Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt   DateTime @updatedAt @map("updated_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  // PK (variant_id, warehouse_id) — index T046
  @@id([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_levels")
}

model InventoryMovement {
  id            BigInt          @id @default(autoincrement())
  variantId     BigInt          @map("variant_id")
  warehouseId   BigInt          @map("warehouse_id")
  lotId         BigInt?         @map("lot_id")
  bucket        InventoryBucket
  change        Int
  type          MovementType
  referenceType String?         @map("reference_type")
  referenceId   BigInt?         @map("reference_id")
  createdById   BigInt?         @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  lot       Lot?           @relation(fields: [lotId], references: [id])
  createdBy User?          @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([variantId, warehouseId, bucket, createdAt]) // T046
  @@map("inventory_movements")
}

model Lot {
  id             BigInt    @id @default(autoincrement())
  code           String
  variantId      BigInt    @map("variant_id")
  manufacturedAt DateTime? @map("manufactured_at") @db.Date
  expiredAt      DateTime? @map("expired_at") @db.Date

  variant   ProductVariant       @relation(fields: [variantId], references: [id])
  movements InventoryMovement[]
  reiItems  GoodsReceiptItem[]
  stnItems  StockTransferItem[]
  pvnItems  PurchaseReturnItem[]

  @@unique([variantId, code])
  @@map("lots")
}

model ActivityLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   BigInt?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("activity_logs")
}

// --- Nhà cung cấp (US5) ---

model Supplier {
  id           BigInt   @id @default(autoincrement())
  code         String   @unique
  name         String
  email        String?
  phone        String?
  website      String?
  fax          String?
  taxCode      String?  @map("tax_code")
  country      String?
  province     String?
  district     String?
  ward         String?
  address      String?
  assignedToId BigInt?  @map("assigned_to")
  tags         String[]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedTo User? @relation("SupplierAssignedTo", fields: [assignedToId], references: [id])

  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  purchaseReturns PurchaseReturn[]
  ledgerEntries   SupplierLedgerEntry[]

  @@map("suppliers")
}

enum SupplierLedgerReferenceType {
  goods_receipt
  payment
  purchase_return
  refund
  adjustment
}

// Sổ công nợ NCC — amount: âm = tăng nợ phải trả NCC, dương = giảm nợ phải trả NCC
model SupplierLedgerEntry {
  id               BigInt                      @id @default(autoincrement())
  supplierId       BigInt                      @map("supplier_id")
  referenceType    SupplierLedgerReferenceType @map("reference_type")
  referenceCode    String?                     @map("reference_code")
  transactionLabel String                      @map("transaction_label")
  reason           String?
  amount           Decimal                     @db.Decimal(18, 2)
  createdById      BigInt                      @map("created_by")
  createdAt        DateTime                    @default(now()) @map("created_at")

  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation("SupplierLedgerCreatedBy", fields: [createdById], references: [id])

  @@index([supplierId, createdAt])
  @@map("supplier_ledger_entries")
}

// --- Đặt hàng nhập & Nhập hàng (US2) ---

model PurchaseOrder {
  id            BigInt   @id @default(autoincrement())
  code          String   @unique
  supplierId    BigInt   @map("supplier_id")
  branchId      BigInt   @map("branch_id")
  warehouseId   BigInt   @map("warehouse_id")
  status        PoStatus @default(don_nhap)
  totalQuantity Int      @default(0) @map("total_quantity")
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(18, 2)
  depositAmount Decimal  @default(0) @map("deposit_amount") @db.Decimal(18, 2)
  createdById   BigInt   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  branch            Branch              @relation(fields: [branchId], references: [id])
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy         User                @relation("PoCreatedBy", fields: [createdById], references: [id])
  items             PurchaseOrderItem[]
  goodsReceipts     GoodsReceipt[]
  goodsReceiptItems GoodsReceiptItem[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               BigInt  @id @default(autoincrement())
  purchaseOrderId  BigInt  @map("purchase_order_id")
  variantId        BigInt  @map("variant_id")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 2)
  receivedQuantity Int     @default(0) @map("received_quantity")

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([purchaseOrderId, variantId])
  @@index([variantId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                BigInt             @id @default(autoincrement())
  code              String             @unique
  supplierId        BigInt             @map("supplier_id")
  warehouseId       BigInt             @map("warehouse_id")
  purchaseOrderId   BigInt?            @map("purchase_order_id")
  status            GoodsReceiptStatus @default(chua_nhap)
  paymentStatus     PaymentStatus      @default(chua_thanh_toan) @map("payment_status")
  amountDue         Decimal            @default(0) @map("amount_due") @db.Decimal(18, 2)
  paidAmount        Decimal            @default(0) @map("paid_amount") @db.Decimal(18, 2)
  discountAmount    Decimal            @default(0) @map("discount_amount") @db.Decimal(18, 2)
  extraCost         Decimal            @default(0) @map("extra_cost") @db.Decimal(18, 2)
  depositApplied    Decimal            @default(0) @map("deposit_applied") @db.Decimal(18, 2)
  assignedToId      BigInt?            @map("assigned_to")
  expectedReceiptAt DateTime?          @map("expected_receipt_at")
  invoiceAt         DateTime?          @map("invoice_at")
  invoiceSymbol     String?            @map("invoice_symbol")
  orderCode         String?            @map("order_code")
  referenceCode     String?            @map("reference_code")
  createdById       BigInt             @map("created_by")
  createdAt         DateTime           @default(now()) @map("created_at")
  receivedAt        DateTime?          @map("received_at")

  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  createdBy       User               @relation("ReiCreatedBy", fields: [createdById], references: [id])
  assignedTo      User?              @relation("ReiAssignedTo", fields: [assignedToId], references: [id])
  items           GoodsReceiptItem[]
  purchaseReturns PurchaseReturn[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              BigInt  @id @default(autoincrement())
  goodsReceiptId  BigInt  @map("goods_receipt_id")
  variantId       BigInt  @map("variant_id")
  purchaseOrderId BigInt? @map("purchase_order_id")
  lotId           BigInt? @map("lot_id")
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 2)

  goodsReceipt  GoodsReceipt   @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  lot           Lot?           @relation(fields: [lotId], references: [id])

  @@index([goodsReceiptId])
  @@index([variantId])
  @@map("goods_receipt_items")
}

// --- Chuyển kho (US3) ---

model StockTransfer {
  id              BigInt              @id @default(autoincrement())
  code            String              @unique
  fromWarehouseId BigInt              @map("from_warehouse_id")
  toWarehouseId   BigInt              @map("to_warehouse_id")
  status          StockTransferStatus @default(nhap)
  note            String?
  totalQuantity   Int                 @default(0) @map("total_quantity")
  createdById     BigInt              @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  shippedAt       DateTime?           @map("shipped_at")
  receivedAt      DateTime?           @map("received_at")
  receivedById    BigInt?             @map("received_by")

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  createdBy     User                @relation("StnCreatedBy", fields: [createdById], references: [id])
  receivedBy    User?               @relation("StnReceivedBy", fields: [receivedById], references: [id])
  items         StockTransferItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              BigInt  @id @default(autoincrement())
  stockTransferId BigInt  @map("stock_transfer_id")
  variantId       BigInt  @map("variant_id")
  lotId           BigInt? @map("lot_id")
  quantity        Int

  stockTransfer StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  lot           Lot?           @relation(fields: [lotId], references: [id])

  @@index([stockTransferId])
  @@index([variantId])
  @@map("stock_transfer_items")
}

// --- Trả hàng nhập (US4) ---

model PurchaseReturn {
  id             BigInt       @id @default(autoincrement())
  code           String       @unique
  supplierId     BigInt       @map("supplier_id")
  warehouseId    BigInt       @map("warehouse_id")
  // Đơn nhập hàng gốc — có giá trị khi tạo phiếu trả "theo đơn", null khi trả tự do
  goodsReceiptId BigInt?      @map("goods_receipt_id")
  totalQuantity  Int          @default(0) @map("total_quantity")
  totalAmount    Decimal      @default(0) @map("total_amount") @db.Decimal(18, 2)
  refundStatus   RefundStatus @default(chua_hoan_tien) @map("refund_status")
  refundedAt     DateTime?    @map("refunded_at")
  createdById    BigInt       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  supplier     Supplier             @relation(fields: [supplierId], references: [id])
  warehouse    Warehouse            @relation(fields: [warehouseId], references: [id])
  goodsReceipt GoodsReceipt?        @relation(fields: [goodsReceiptId], references: [id])
  createdBy    User                 @relation("PvnCreatedBy", fields: [createdById], references: [id])
  items        PurchaseReturnItem[]

  @@index([supplierId, createdAt])
  @@index([goodsReceiptId])
  @@index([createdAt])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               BigInt  @id @default(autoincrement())
  purchaseReturnId BigInt  @map("purchase_return_id")
  variantId        BigInt  @map("variant_id")
  lotId            BigInt? @map("lot_id")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  lot            Lot?           @relation(fields: [lotId], references: [id])

  @@index([purchaseReturnId])
  @@index([variantId])
  @@map("purchase_return_items")
}

// --- Module Đơn hàng (002) ---

model Customer {
  id        BigInt   @id @default(autoincrement())
  sapoId    BigInt?  @unique @map("sapo_id")
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  email     String?
  phone     String?
  company   String?
  tags      String[] @default([])
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  orders        Order[]
  draftOrders   DraftOrder[]
  conversations Conversation[]
  ledgerEntries CustomerLedgerEntry[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

enum CustomerLedgerReferenceType {
  order
  payment
  order_return
  refund
  adjustment
}

// Sổ công nợ KH — amount: dương = tăng nợ phải thu (khách nợ thêm), âm = giảm nợ phải thu
model CustomerLedgerEntry {
  id               BigInt                      @id @default(autoincrement())
  customerId       BigInt                      @map("customer_id")
  referenceType    CustomerLedgerReferenceType @map("reference_type")
  referenceCode    String?                     @map("reference_code")
  transactionLabel String                      @map("transaction_label")
  reason           String?
  amount           Decimal                     @db.Decimal(18, 2)
  createdById      BigInt                      @map("created_by")
  createdAt        DateTime                    @default(now()) @map("created_at")

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation("CustomerLedgerCreatedBy", fields: [createdById], references: [id])

  @@index([customerId, createdAt])
  @@map("customer_ledger_entries")
}

model Order {
  id                 BigInt        @id @default(autoincrement())
  sapoId             BigInt?       @unique @map("sapo_id")
  code               String        @unique
  customerId         BigInt?       @map("customer_id")
  branchId           BigInt        @map("branch_id")
  source             OrderSource   @default(other)
  status             OrderStatus   @default(ordered)
  assignedToId       BigInt?       @map("assigned_to")
  createdById        BigInt        @map("created_by")
  email              String?
  phone              String?
  subtotal           Decimal       @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal       @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal           Decimal       @default(0) @map("tax_total") @db.Decimal(18, 2)
  shippingFee        Decimal       @default(0) @map("shipping_fee") @db.Decimal(18, 2)
  totalAmount        Decimal       @default(0) @map("total_amount") @db.Decimal(18, 2)
  totalQuantity      Int           @default(0) @map("total_quantity")
  paymentStatus      PaymentStatus @default(chua_thanh_toan) @map("payment_status")
  paidAmount         Decimal       @default(0) @map("paid_amount") @db.Decimal(18, 2)
  note               String?       @db.Text
  tags               String[]      @default([])
  orderedAt          DateTime      @default(now()) @map("ordered_at")
  expectedDeliveryAt DateTime?     @map("expected_delivery_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer   Customer?     @relation(fields: [customerId], references: [id])
  branch     Branch        @relation(fields: [branchId], references: [id])
  assignedTo User?         @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  createdBy  User          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items      OrderItem[]
  returns    OrderReturn[]
  fromDraft  DraftOrder?   @relation("DraftConverted")

  @@index([branchId, status, orderedAt])
  @@index([orderedAt])
  @@index([customerId])
  @@index([assignedToId])
  @@map("orders")
}

model OrderItem {
  id          BigInt  @id @default(autoincrement())
  orderId     BigInt  @map("order_id")
  variantId   BigInt  @map("variant_id")
  warehouseId BigInt  @map("warehouse_id")
  productName String  @map("product_name")
  sku         String
  quantity    Int
  price       Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("order_items")
}

model DraftOrder {
  id               BigInt           @id @default(autoincrement())
  code             String           @unique
  branchId         BigInt           @map("branch_id")
  customerId       BigInt?          @map("customer_id")
  source           OrderSource      @default(other)
  status           DraftOrderStatus @default(draft)
  createdById      BigInt           @map("created_by")
  currency         String           @default("VND")
  subtotal         Decimal          @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal          @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal         Decimal          @default(0) @map("tax_total") @db.Decimal(18, 2)
  shippingFee      Decimal          @default(0) @map("shipping_fee") @db.Decimal(18, 2)
  totalAmount      Decimal          @default(0) @map("total_amount") @db.Decimal(18, 2)
  shippingMethod   String?          @map("shipping_method")
  note             String?          @db.Text
  tags             String[]         @default([])
  convertedOrderId BigInt?          @unique @map("converted_order_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  branch         Branch           @relation(fields: [branchId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id])
  createdBy      User             @relation("DraftOrderCreatedBy", fields: [createdById], references: [id])
  convertedOrder Order?           @relation("DraftConverted", fields: [convertedOrderId], references: [id])
  items          DraftOrderItem[]

  @@index([status, createdAt])
  @@index([customerId])
  @@map("draft_orders")
}

model DraftOrderItem {
  id           BigInt  @id @default(autoincrement())
  draftOrderId BigInt  @map("draft_order_id")
  variantId    BigInt  @map("variant_id")
  warehouseId  BigInt  @map("warehouse_id")
  productName  String  @map("product_name")
  sku          String
  quantity     Int
  price        Decimal @db.Decimal(18, 2)
  discount     Decimal @default(0) @db.Decimal(18, 2)

  draftOrder DraftOrder     @relation(fields: [draftOrderId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id])

  @@index([draftOrderId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("draft_order_items")
}

model OrderReturn {
  id           BigInt   @id @default(autoincrement())
  code         String   @unique
  orderId      BigInt   @map("order_id")
  reason       String?  @db.Text
  refundAmount Decimal  @default(0) @map("refund_amount") @db.Decimal(18, 2)
  restock      Boolean  @default(true)
  createdById  BigInt   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  order     Order             @relation(fields: [orderId], references: [id])
  createdBy User              @relation("OrderReturnCreatedBy", fields: [createdById], references: [id])
  items     OrderReturnItem[]

  @@index([orderId])
  @@index([createdAt])
  @@map("order_returns")
}

model OrderReturnItem {
  id            BigInt  @id @default(autoincrement())
  orderReturnId BigInt  @map("order_return_id")
  variantId     BigInt  @map("variant_id")
  warehouseId   BigInt  @map("warehouse_id")
  productName   String  @map("product_name")
  sku           String
  variantTitle  String? @map("variant_title")
  quantity      Int
  price         Decimal @db.Decimal(18, 2)

  orderReturn OrderReturn    @relation(fields: [orderReturnId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])

  @@index([orderReturnId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("order_return_items")
}

model Voucher {
  id             BigInt      @id @default(autoincrement())
  code           String      @unique
  type           VoucherType
  amountIn       Decimal     @default(0) @map("amount_in") @db.Decimal(18, 2)
  amountOut      Decimal     @default(0) @map("amount_out") @db.Decimal(18, 2)
  branchId       BigInt      @map("branch_id")
  createdById    BigInt      @map("created_by")
  sourceDocument String?     @map("source_document")
  referenceType  String?     @map("reference_type")
  referenceId    BigInt?     @map("reference_id")
  reason         String?     @db.Text
  recordedAt     DateTime    @default(now()) @map("recorded_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("VoucherCreatedBy", fields: [createdById], references: [id])

  @@index([branchId, type, recordedAt])
  @@map("vouchers")
}

// --- Chat CSKH (002 US4) ---

model Conversation {
  id            BigInt      @id @default(autoincrement())
  channel       OrderSource @default(other)
  customerName  String      @map("customer_name")
  customerPhone String      @map("customer_phone")
  customerId    BigInt?     @map("customer_id")
  assignedToId  BigInt?     @map("assigned_to")
  lastMessageAt DateTime    @default(now()) @map("last_message_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  customer   Customer?             @relation(fields: [customerId], references: [id])
  assignedTo User?                 @relation("ConversationAssignedTo", fields: [assignedToId], references: [id])
  messages   ConversationMessage[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id             BigInt   @id @default(autoincrement())
  conversationId BigInt   @map("conversation_id")
  senderType     String   @map("sender_type")
  body           String   @db.Text
  createdById    BigInt?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ConversationMessageAuthor", fields: [createdById], references: [id])

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

// --- CQA CSKH / Facebook inbox ---

model ChatAudit {
  id           String   @id @default(uuid()) @db.Uuid
  userId       BigInt?  @map("user_id")
  agentName    String?  @map("agent_name") @db.VarChar
  customerName String?  @map("customer_name") @db.VarChar
  channel      String?  @db.VarChar
  score        Int      @default(0)
  feedback     String?  @db.Text
  transcript   Json?
  metadata     Json?
  tenantId     String?  @map("tenant_id") @db.Uuid
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("chat_audits")
}

model FacebookCskhConfig {
  id              String   @id @default(uuid()) @db.Uuid
  pageId          String   @unique @map("page_id")
  pageName        String?  @map("page_name") @db.VarChar
  pageAccessToken String   @map("page_access_token") @db.Text
  enabled         Boolean  @default(true)
  metadata        Json?
  tenantId        String?  @map("tenant_id") @db.Uuid
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("facebook_cskh_configs")
}

model FacebookOAuthSession {
  id              String    @id @default(uuid()) @db.Uuid
  fbUserId        String    @unique @map("fb_user_id")
  fbUserName      String?   @map("fb_user_name") @db.VarChar
  userAccessToken String    @map("user_access_token") @db.Text
  tokenExpiresAt  DateTime? @map("token_expires_at") @db.Timestamptz(6)
  metadata        Json?
  tenantId        String?   @map("tenant_id") @db.Uuid
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("facebook_oauth_sessions")
}

model CskhJobRun {
  id           String            @id @default(uuid()) @db.Uuid
  type         String
  status       String            @default("running")
  summary      Json?
  error        String?           @db.Text
  tenantId     String?           @map("tenant_id") @db.Uuid
  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedAt    DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?         @map("finished_at") @db.Timestamptz(6)
  monitorItems CskhMonitorItem[]

  @@map("cskh_job_runs")
}

model CskhMonitorItem {
  id             String     @id @default(uuid()) @db.Uuid
  jobRunId       String     @map("job_run_id") @db.Uuid
  pageId         String     @map("page_id")
  pageName       String?    @map("page_name") @db.VarChar
  conversationId String     @map("conversation_id")
  customerName   String?    @map("customer_name") @db.VarChar
  lastMessage    String?    @map("last_message") @db.Text
  needsReply     Boolean    @default(true) @map("needs_reply")
  tenantId       String?    @map("tenant_id") @db.Uuid
  tenant         Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt      DateTime?  @map("updated_at") @db.Timestamptz(6)
  jobRun         CskhJobRun @relation(fields: [jobRunId], references: [id], onDelete: Cascade)

  @@map("cskh_monitor_items")
}

model CskhInboxConversation {
  id                 String                       @id @default(uuid()) @db.Uuid
  pageId             String                       @map("page_id")
  pageName           String?                      @map("page_name") @db.VarChar
  fbConversationId   String?                      @map("fb_conversation_id") @db.VarChar
  participantPsid    String                       @map("participant_psid")
  customerName       String?                      @map("customer_name") @db.VarChar
  customerPictureUrl String?                      @map("customer_picture_url") @db.VarChar
  lastMessage        String?                      @map("last_message") @db.Text
  lastMessageAt      DateTime?                    @map("last_message_at") @db.Timestamptz(6)
  unreadCount        Int                          @default(0) @map("unread_count")
  awaitingLabel      Boolean                      @default(false) @map("awaiting_label")
  fromAd             Boolean                      @default(false) @map("from_ad")
  adId               String?                      @map("ad_id") @db.VarChar
  adTitle            String?                      @map("ad_title") @db.VarChar
  referralSource     String?                      @map("referral_source") @db.VarChar
  referralAt         DateTime?                    @map("referral_at") @db.Timestamptz(6)
  // Ngôn ngữ khách (ISO 639-1) — dùng khi NV bật tự dịch khi gửi. Persist ở BE.
  customerLang       String?                      @map("customer_lang") @db.VarChar(16)
  customerLangLabel  String?                      @map("customer_lang_label") @db.VarChar(64)
  tenantId           String?                      @map("tenant_id") @db.Uuid
  tenant             Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages           CskhInboxMessage[]
  labelAssignments   CskhInboxConversationLabel[]
  views              CskhInboxConversationView[]

  @@unique([pageId, participantPsid])
  @@index([tenantId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([pageId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, fromAd, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("cskh_inbox_conversations")
}

model CskhInboxMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  fbMessageId    String?               @unique @map("fb_message_id") @db.VarChar
  direction      String
  senderType     String                @map("sender_type")
  // Nội dung gửi/nhận trên Facebook (ngôn ngữ khách nếu đã dịch outbound).
  text           String                @db.Text
  // Bản gốc NV gõ (thường VI) khi auto-translate outbound.
  originalText   String?               @map("original_text") @db.Text
  // Bản dịch tiếng Việt để NV đọc (inbound), hoặc mirror originalText (outbound).
  translatedText String?               @map("translated_text") @db.Text
  // Ngôn ngữ của `text` (ISO 639-1).
  sourceLang     String?               @map("source_lang") @db.VarChar(16)
  messageType    String                @default("text") @map("message_type")
  attachmentUrl  String?               @map("attachment_url") @db.Text
  tenantId       String?               @map("tenant_id") @db.Uuid
  tenant         Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sentAt         DateTime              @default(now()) @map("sent_at") @db.Timestamptz(6)
  status         String                @default("sent")
  conversation   CskhInboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId, sentAt(sort: Desc)])
  @@index([sentAt(sort: Desc)])
  @@index([direction, sentAt(sort: Desc)])
  @@map("cskh_inbox_messages")
}

model CskhInboxLabel {
  id          String                       @id @default(uuid()) @db.Uuid
  tenantId    String?                      @map("tenant_id") @db.Uuid
  tenant      Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String                       @db.VarChar(80)
  color       String                       @default("#6366f1") @db.VarChar(20)
  type        String                       @db.VarChar(20)
  userId      BigInt?                      @map("user_id")
  user        User?                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sortOrder   Int                          @default(0) @map("sort_order")
  isActive    Boolean                      @default(true) @map("is_active")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments CskhInboxConversationLabel[]

  @@unique([tenantId, type, userId])
  @@unique([tenantId, type, name])
  @@index([tenantId, type, sortOrder])
  @@map("cskh_inbox_labels")
}

model CskhInboxConversationLabel {
  id               String                @id @default(uuid()) @db.Uuid
  conversationId   String                @map("conversation_id") @db.Uuid
  labelId          String                @map("label_id") @db.Uuid
  assignedByUserId BigInt?               @map("assigned_by_user_id")
  assignedAt       DateTime              @default(now()) @map("assigned_at") @db.Timestamptz(6)
  conversation     CskhInboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label            CskhInboxLabel        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([conversationId, labelId])
  @@index([conversationId])
  @@index([labelId])
  @@map("cskh_inbox_conversation_labels")
}

model CskhInboxConversationView {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  userId         BigInt                @map("user_id")
  viewedAt       DateTime              @default(now()) @map("viewed_at") @db.Timestamptz(6)
  conversation   CskhInboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId, viewedAt(sort: Desc)])
  @@map("cskh_inbox_conversation_views")
}

model CskhPageAdSpendDaily {
  id                     String   @id @default(uuid()) @db.Uuid
  pageId                 String   @map("page_id")
  statDate               String   @map("stat_date") @db.VarChar(10)
  spend                  Float?
  currency               String?  @db.VarChar(8)
  messagingConversations Int?     @map("messaging_conversations")
  costPerConversation    Float?   @map("cost_per_conversation")
  adAccountId            String?  @map("ad_account_id")
  adAccountName          String?  @map("ad_account_name") @db.VarChar
  unavailableReason      String?  @map("unavailable_reason") @db.VarChar(64)
  tenantId               String?  @map("tenant_id") @db.Uuid
  syncedAt               DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([pageId, statDate])
  @@index([statDate])
  @@index([tenantId, statDate])
  @@map("cskh_page_ad_spend_daily")
}

/// Cache tổng tin nhắn theo Page (manual SQL / Page-Kênh) — giữ trong schema để db push không drop.
model CskhPageMessageTotals {
  pageId                   String   @id @map("page_id")
  messageCount             BigInt   @default(0) @map("message_count")
  conversationCount        BigInt   @default(0) @map("conversation_count")
  unreadConversationCount  BigInt   @default(0) @map("unread_conversation_count")
  refreshedAt              DateTime @default(now()) @map("refreshed_at") @db.Timestamptz(6)

  @@index([refreshedAt])
  @@map("cskh_page_message_totals")
}

// --- Sapo mirror (đầy đủ cột để hiển thị UI / báo cáo) ---

model SapoCustomer {
  id                 BigInt    @id @default(autoincrement())
  sapoId             BigInt    @unique @map("sapo_id")
  email              String?
  phone              String?
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  fullName           String?   @map("full_name")
  gender             String?
  dob                DateTime? @db.Date
  company            String?
  acceptsMarketing   Boolean   @default(false) @map("accepts_marketing")
  verifiedEmail      Boolean   @default(false) @map("verified_email")
  state              String?
  ordersCount        Int       @default(0) @map("orders_count")
  totalSpent         Decimal   @default(0) @map("total_spent") @db.Decimal(18, 2)
  lastOrderSapoId    BigInt?   @map("last_order_sapo_id")
  lastOrderName      String?   @map("last_order_name")
  tags               String[]  @default([])
  note               String?   @db.Text
  /// Địa chỉ mặc định — tách cột để FE hiển thị
  addressName        String?   @map("address_name")
  addressPhone       String?   @map("address_phone")
  address1           String?   @map("address1")
  address2           String?   @map("address2")
  ward               String?
  district           String?
  city               String?
  province           String?
  provinceCode       String?   @map("province_code")
  districtCode       String?   @map("district_code")
  wardCode           String?   @map("ward_code")
  country            String?
  countryCode        String?   @map("country_code")
  zip                String?
  sapoCreatedAt      DateTime? @map("sapo_created_at")
  sapoModifiedAt     DateTime? @map("sapo_modified_at")
  syncedAt           DateTime  @default(now()) @map("synced_at")

  orders SapoOrder[]

  @@index([phone])
  @@index([email])
  @@index([fullName])
  @@map("sapo_customers")
}

model SapoOrder {
  id                      BigInt    @id @default(autoincrement())
  sapoId                  BigInt    @unique @map("sapo_id")
  code                    String    @map("code")
  orderNumber             Int?      @map("order_number")
  /// open | closed | cancelled (Sapo)
  sapoStatus              String?   @map("sapo_status")
  financialStatus         String?   @map("financial_status")
  fulfillmentStatus       String?   @map("fulfillment_status")
  gateway                 String?
  sourceName              String?   @map("source_name")
  currency                String?   @default("VND")
  email                   String?
  phone                   String?
  note                    String?   @db.Text
  tags                    String[]  @default([])
  cancelReason            String?   @map("cancel_reason")
  customerSapoId          BigInt?   @map("customer_sapo_id")
  customerName            String?   @map("customer_name")
  customerId              BigInt?   @map("customer_id")
  /// Tiền — tách cột
  subtotalPrice           Decimal   @default(0) @map("subtotal_price") @db.Decimal(18, 2)
  totalLineItemsPrice     Decimal   @default(0) @map("total_line_items_price") @db.Decimal(18, 2)
  totalDiscounts          Decimal   @default(0) @map("total_discounts") @db.Decimal(18, 2)
  totalTax                Decimal   @default(0) @map("total_tax") @db.Decimal(18, 2)
  totalShippingPrice      Decimal   @default(0) @map("total_shipping_price") @db.Decimal(18, 2)
  totalPrice              Decimal   @default(0) @map("total_price") @db.Decimal(18, 2)
  totalOutstanding        Decimal   @default(0) @map("total_outstanding") @db.Decimal(18, 2)
  unpaidAmount            Decimal   @default(0) @map("unpaid_amount") @db.Decimal(18, 2)
  totalReceived           Decimal   @default(0) @map("total_received") @db.Decimal(18, 2)
  totalRefunded           Decimal   @default(0) @map("total_refunded") @db.Decimal(18, 2)
  itemQuantity            Int       @default(0) @map("item_quantity")
  /// Ngày
  createdOn               DateTime? @map("created_on")
  modifiedOn              DateTime? @map("modified_on")
  paidOn                  DateTime? @map("paid_on")
  cancelledOn             DateTime? @map("cancelled_on")
  closedOn                DateTime? @map("closed_on")
  expectedDeliveryDate    DateTime? @map("expected_delivery_date")
  /// Địa chỉ giao hàng
  shipName                String?   @map("ship_name")
  shipPhone               String?   @map("ship_phone")
  shipCompany             String?   @map("ship_company")
  shipAddress1            String?   @map("ship_address1")
  shipAddress2            String?   @map("ship_address2")
  shipWard                String?   @map("ship_ward")
  shipDistrict            String?   @map("ship_district")
  shipCity                String?   @map("ship_city")
  shipProvince            String?   @map("ship_province")
  shipCountry             String?   @map("ship_country")
  shipZip                 String?   @map("ship_zip")
  /// Địa chỉ thanh toán
  billName                String?   @map("bill_name")
  billPhone               String?   @map("bill_phone")
  billAddress1            String?   @map("bill_address1")
  billDistrict            String?   @map("bill_district")
  billCity                String?   @map("bill_city")
  billProvince            String?   @map("bill_province")
  billCountry             String?   @map("bill_country")
  syncedAt                DateTime  @default(now()) @map("synced_at")

  customer SapoCustomer?     @relation(fields: [customerId], references: [id])
  items    SapoOrderLineItem[]

  @@index([code])
  @@index([financialStatus])
  @@index([fulfillmentStatus])
  @@index([sapoStatus])
  @@index([createdOn])
  @@index([customerSapoId])
  @@index([phone])
  @@map("sapo_orders")
}

model SapoOrderLineItem {
  id                BigInt  @id @default(autoincrement())
  orderId           BigInt  @map("order_id")
  sapoLineItemId    BigInt? @map("sapo_line_item_id")
  productSapoId     BigInt? @map("product_sapo_id")
  variantSapoId     BigInt? @map("variant_sapo_id")
  title             String?
  variantTitle      String? @map("variant_title")
  name              String?
  sku               String?
  vendor            String?
  unit              String?
  quantity          Int     @default(0)
  price             Decimal @default(0) @db.Decimal(18, 2)
  totalDiscount     Decimal @default(0) @map("total_discount") @db.Decimal(18, 2)
  discountedTotal   Decimal @default(0) @map("discounted_total") @db.Decimal(18, 2)
  fulfillmentStatus String? @map("fulfillment_status")
  requiresShipping  Boolean @default(true) @map("requires_shipping")
  taxable           Boolean @default(true)

  order SapoOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([sku])
  @@index([productSapoId])
  @@index([variantSapoId])
  @@map("sapo_order_line_items")
}

// --- Sapo catalog mirror (test / offline) + inbox orders ---

model SapoCatalogVariant {
  id             Int      @id @default(autoincrement())
  sapoProductId  Int      @map("sapo_product_id")
  sapoVariantId  Int      @unique @map("sapo_variant_id")
  productTitle   String   @map("product_title")
  variantTitle   String   @default("Default") @map("variant_title")
  price          Decimal  @db.Decimal(18, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(18, 2)
  sku            String?
  tags           String   @default("")
  imageUrl       String?  @map("image_url")
  inventoryQty   Int      @default(0) @map("inventory_qty")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("sapo_catalog_variants")
}

model SapoInboxOrder {
  id              String   @id @default(uuid()) @db.Uuid
  orderNumber     Int      @unique @default(autoincrement()) @map("order_number")
  conversationId  String?  @map("conversation_id") @db.Uuid
  participantPsid String?  @map("participant_psid") @db.VarChar(64)
  customerName    String   @map("customer_name")
  phone           String?  @db.VarChar(32)
  address         String?  @db.Text
  note            String?  @db.Text
  status          String   @default("pending") @db.VarChar(32)
  totalPrice      Decimal  @default(0) @map("total_price") @db.Decimal(18, 2)
  source          String   @default("db") @db.VarChar(16)
  externalOrderId Int?     @map("external_order_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  items SapoInboxOrderItem[]

  @@index([conversationId])
  @@index([createdAt(sort: Desc)])
  @@map("sapo_inbox_orders")
}

model SapoInboxOrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  variantId   BigInt  @map("variant_id")
  productName String  @map("product_name")
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 2)
  quantity    Int
  lineTotal   Decimal @map("line_total") @db.Decimal(18, 2)

  order   SapoInboxOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("sapo_inbox_order_items")
}
