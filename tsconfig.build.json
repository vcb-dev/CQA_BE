{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // nest-cli deleteOutDir + incremental dễ để lại tsbuildinfo “up to date”
    // trong khi dist đã bị xóa → Cannot find module dist/main
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "backfill-inbox.ts", "scripts"]
}
